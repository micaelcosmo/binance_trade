# Binance API: use config/user.cfg (recommended). Do NOT set these if user.cfg is configured —
# a non-empty API_KEY here overrides user.cfg and often causes error -2014.
# API_KEY=
# API_SECRET_KEY=

# Google Gemini (required for profit_gain AI)
GOOGLE_API_KEY=

# testnet: configure only in config/user.cfg (testnet = True/False).
# Do NOT set TESTNET here — the string "false" is truthy in Python and breaks live trading (-2015).

# Strategy name (must match a *_strategy.py file without suffix)
STRATEGY=profit_gain

# Container timezone (helps avoid Binance -1021 timestamp errors)
TZ=America/Sao_Paulo

# noVNC browser access
NOVNC_PORT=6080
VNC_PASSWORD=change-me
